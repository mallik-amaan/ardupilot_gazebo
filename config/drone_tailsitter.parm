Q_ENABLE         1
Q_FRAME_CLASS    1
Q_FRAME_TYPE     1
; Tailsitter DISABLED (this vehicle is a multicopter, not a tailsitter).
; Q_TAILSIT_ENABLE 0 is required so Tailsitter::setup()'s "old heuristic"
; (auto-set ENABLE=1 whenever MOTMX != 0) cannot fire — an explicit 0 still
; counts as "configured". MOTMX=0 also blocks that heuristic independently.
; With ENABLE=0, quadplane.cpp:726 creates ahrs_view with ROTATION_NONE, so Q
; modes no longer publish/steer on the ROTATION_PITCH_90 tailsitter view (the
; 180/90 "phantom"). Q_FRAME_CLASS/TYPE and the SERVO->motor map are unchanged.
Q_TAILSIT_ENABLE 0
Q_TAILSIT_MOTMX  0
; QuadPlane Q motors -> 4 rotor outputs (Motor1-4 = 33-36) so QHOVER mixer drives them
SERVO1_FUNCTION  33
SERVO2_FUNCTION  34
SERVO3_FUNCTION  35
SERVO4_FUNCTION  36
Q_A_ACC_P_MAX    2070.69
Q_A_ACC_R_MAX    1178.85
Q_A_ACC_Y_MAX    122.87
Q_A_ANGLE_BOOST  1.000000
Q_A_ANG_LIM_TC   1.000000
Q_A_ANG_PIT_P    12.000000
Q_A_ANG_RLL_P    12.000000
Q_A_ANG_YAW_P    1.000000
Q_A_INPUT_TC     0.200000
Q_A_RATE_FF_ENAB 1.000000
Q_A_RATE_P_MAX   0.000000
Q_A_RATE_R_MAX   0.000000
Q_A_RATE_Y_MAX   0.000000
Q_A_RAT_PIT_D    0.008000
Q_A_RAT_PIT_FF   0.000000
Q_A_RAT_PIT_I    0.150000
Q_A_RAT_PIT_IMAX 0.300000
Q_A_RAT_PIT_P    0.400000
Q_A_RAT_RLL_D    0.008000
Q_A_RAT_RLL_FF   0.000000
Q_A_RAT_RLL_I    0.150000
Q_A_RAT_RLL_IMAX 0.300000
Q_A_RAT_RLL_P    0.400000
Q_A_RAT_YAW_D    0.000000
Q_A_RAT_YAW_FF   0.000000
Q_A_RAT_YAW_I    0.020000
Q_A_RAT_YAW_IMAX 0.100000
Q_A_RAT_YAW_P    0.100000
Q_TRANS_DECEL    8
