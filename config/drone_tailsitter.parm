Q_ENABLE         1
Q_FRAME_CLASS    1
Q_FRAME_TYPE     1
; Tailsitter DISABLED (this vehicle is a multicopter, not a tailsitter).
; Q_TAILSIT_ENABLE 0 is required so Tailsitter::setup()'s "old heuristic"
; (auto-set ENABLE=1 whenever MOTMX != 0) cannot fire — an explicit 0 still
; counts as "configured". MOTMX=0 also blocks that heuristic independently.
; With ENABLE=0, quadplane.cpp:726 creates ahrs_view with ROTATION_NONE, so Q
; modes no longer publish/steer on the ROTATION_PITCH_90 tailsitter view (the
; 180/90 "phantom"). Q_FRAME_CLASS/TYPE and the SERVO->motor map are unchanged.
Q_TAILSIT_ENABLE 0
Q_TAILSIT_MOTMX  0
; Q_ASSIST_SPEED must be non-zero to pass the pre-arm gate that is only
; skipped while a tailsitter is enabled (AP_Arming_Plane.cpp:209). This
; vehicle is VTOL-only (no wings, never enters forward flight), so -1
; explicitly disables all Q_ASSIST features except transitions - which we
; never reach - instead of leaving the default 0 (which fails arming).
Q_ASSIST_SPEED   -1
; The frame defaults (quadplane-copter_tailsitter.parm) enable a SIM
; rangefinder (RNGFND1_TYPE 100) + RNGFND_LANDING, but this model has no
; range sensor, so the plugin never sends rng_0 and arming fails with
; "PreArm: Rangefinder 1: No Data" (Type::SIM -> AP_RangeFinder_SITL reads
; sitl->get_rangefinder()). Disable it to pass the pre-arm gate; a real
; range sensor (model <sensor type=ray> + plugin <sensor><topic>) is the
; follow-up for precision landing.
RNGFND1_TYPE     0
; QuadPlane Q motors -> 4 rotor outputs (Motor1-4 = 33-36) so QHOVER mixer drives them
SERVO1_FUNCTION  33
SERVO2_FUNCTION  34
SERVO3_FUNCTION  35
SERVO4_FUNCTION  36
Q_A_ACC_P_MAX    2070.69
Q_A_ACC_R_MAX    1178.85
Q_A_ACC_Y_MAX    122.87
Q_A_ANGLE_BOOST  1.000000
Q_A_ANG_LIM_TC   1.000000
Q_A_ANG_PIT_P    12.000000
Q_A_ANG_RLL_P    12.000000
Q_A_ANG_YAW_P    1.000000
Q_A_INPUT_TC     0.200000
Q_A_RATE_FF_ENAB 1.000000
Q_A_RATE_P_MAX   0.000000
Q_A_RATE_R_MAX   0.000000
Q_A_RATE_Y_MAX   0.000000
Q_A_RAT_PIT_D    0.008000
Q_A_RAT_PIT_FF   0.000000
Q_A_RAT_PIT_I    0.150000
Q_A_RAT_PIT_IMAX 0.300000
Q_A_RAT_PIT_P    0.400000
Q_A_RAT_RLL_D    0.008000
Q_A_RAT_RLL_FF   0.000000
Q_A_RAT_RLL_I    0.150000
Q_A_RAT_RLL_IMAX 0.300000
Q_A_RAT_RLL_P    0.400000
Q_A_RAT_YAW_D    0.000000
Q_A_RAT_YAW_FF   0.000000
Q_A_RAT_YAW_I    0.100000
Q_A_RAT_YAW_IMAX 0.400000
; Yaw authority. The frame defaults (P=0.10, I=0.02, IMAX=0.10) cannot reject
; the yaw disturbance produced while leaning hard for the rocket dash - the
; heading wandered at ~35 deg/s and a rotating heading rotates the lean
; direction, which turns the dash into an orbit. Verified live: level flight
; drifts only 0.4 deg/s, so the disturbance is lean-induced.
Q_A_RAT_YAW_P    0.350000
Q_TRANS_DECEL    8

; --------------------------------------------------------------------------- ;
; High-speed "rocket dash" limits (tilt-and-move / Auto Goto).
;
; The dash runs in QHOVER with a directly-commanded lean, because QLOITER
; always takes min(Q_LOIT_ANG_MAX, alt-hold lean limiter) and the alt-hold
; limiter is a compile-time constant (acos(throttle/(0.8*Tmax)) ~46 deg), so
; QLOITER can never lean past ~46 deg.  QHOVER has no such limiter - it uses
; Q_A_ANGLE_MAX directly - so the caps below are what actually matter.
; --------------------------------------------------------------------------- ;
; Lean cap for the dash (attitude controller, range 10-80).  70 deg leaves the
; ~46 deg QLOITER/approach limit untouched while allowing a true nose-forward
; attitude at speed.
Q_A_ANGLE_MAX    70
; Bit 14: "ignore forward flight angle limits in Q modes and use Q_A_ANGLE_MAX
; exclusively".  Without it QHOVER/QSTABILIZE pitch is clipped by
; PTCH_LIM_MAX_DEG (30 deg in the frame defaults) and roll by ROLL_LIMIT_DEG.
Q_OPTIONS        16384
; QLOITER caps (approach / arrival / hold only; the dash itself is QHOVER).
; ANG_MAX range is 0-45, 45 is its hard maximum.
Q_LOIT_ANG_MAX   45
Q_LOIT_ACC_MAX_M 5.0
Q_LOIT_BRK_ACC_M 2.5
; Default dash speed.  The companion overrides this per flight (m/s); the
; value above the documented 0.2-35 range is accepted because it is a float
; parameter and the EKF control ground speed limit is 400 m/s.
Q_LOIT_SPEED_MS  40
; Rotor thrust is left at the airframe's design value (area 0.002), so the
; hover trim stays at the motors default 0.35. (Scaling the rotors x1.75/x2.5
; raised the achievable tilt but the vehicle sank above ~45-50 deg and the
; dash top speed barely moved - see model.sdf / DRONE_TAILSITTER.md.)
Q_M_THST_HOVER   0.35
